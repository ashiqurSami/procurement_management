<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Define the category for Procurement Management -->
    <record model="ir.module.category" id="module_category_procurement_management">
        <field name="name">Procurement Management</field>
        <field name="description">Procurement Management</field>
    </record>

    <!-- Define the Reviewer group -->
    <record id="group_procurement_management_reviewer" model="res.groups">
        <field name="name">Reviewer</field>
        <field name="comment">The reviewer will have access to the supplier registration form. They
            can recommend, reject or blacklist the application
        </field>
        <field name="category_id" ref="module_category_procurement_management"/>
    </record>

    <!-- Define the Approver group -->
    <record id="group_procurement_management_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="comment">The approver will have access to the reviewer recommended supplier registration form.
            They can recommend, reject or blacklist the application
        </field>
        <field name="category_id" ref="module_category_procurement_management"/>
        <!-- Remove the implied_ids field -->
    </record>
</odoo>