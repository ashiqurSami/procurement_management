<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_supplier_registration_search" model="ir.ui.view">
        <field name="name">procurement.management.supplier.registration.search</field>
        <field name="model">procurement_management.supplier.registration</field>
        <field name="arch" type="xml">
            <search string="Supplier Registration">
                <!-- Filters -->
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Reviewed" name="reviewed" domain="[('state', '=', 'reviewed')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <filter string="Blacklisted" name="blacklisted" domain="[('state', '=', 'blacklisted')]"/>

                <!-- Filter: Records Updated by Current User -->
                <filter string="Updated by Me" name="updated_by_me" domain="[('write_uid', '=', uid)]"/>

                <!-- Group By Options -->
                <group expand="1" string="Group By">
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Company Category" name="group_by_company_category" context="{'group_by': 'company_type_category'}"/>
                    <filter string="Reviewer" name="group_by_reviewer" context="{'group_by': 'reviewer_id'}"/>
                    <filter string="Approver" name="group_by_approver" context="{'group_by': 'approver_id'}"/>
                    <filter string="Certifying Body" name="group_by_certifying_body" context="{'group_by': 'certifying_body'}"/>
                </group>

                <!-- Search Fields -->
                <field name="company_name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="company_type_category"/>
                <field name="trade_license_number"/>
                <field name="tax_identification_number"/>
                <field name="commencement_date"/>
                <field name="expiry_date"/>
                <field name="state"/>
                <field name="reviewer_id"/>
                <field name="approver_id"/>
                <field name="certifying_body"/>
            </search>
        </field>
    </record>

    <record id="procurement_management_supplier_registration_view_form" model="ir.ui.view">
        <field name="name">procurement.management.supplier.registration.view.form.base</field>
        <field name="model">procurement_management.supplier.registration</field>
        <field name="arch" type="xml">
            <form string="Supplier Registration">
                <header>
<!--                    <button name="action_submit" string="Submit" type="object" class="oe_highlight" invisible="state != 'draft'" />-->
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'reviewed'" groups="procurement_management.group_procurement_management_approver" />
                    <button name="action_recommend" string="Review" type="object" class="oe_highlight" invisible="state != 'submitted'" groups="procurement_management.group_procurement_management_reviewer" />
                    <button name="action_reject_or_blacklist" string="Reject" type="object" class="btn-danger" invisible="state != 'submitted'" context="{'rejected':True}" groups="procurement_management.group_procurement_management_reviewer" />
                    <button name="action_reject_or_blacklist" string="Blacklist" type="object" class="btn-danger" invisible="state != 'submitted'" context="{'blacklisted':True}" groups="procurement_management.group_procurement_management_reviewer"/>
                    <button name="action_reject_or_blacklist" string="Reject" type="object" class="btn-danger" invisible="state != 'reviewed'" context="{'rejected':True}" groups="procurement_management.group_procurement_management_approver" />

                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_name" readonly="1"/>
                            <field name="phone" readonly="1"/>
                            <field name="email" readonly="1"/>
                            <field name="company_type_category" readonly="1"/>
                            <field name="trade_license_number" readonly="1"/>
                            <field name="tax_identification_number" readonly="1"/>
                        </group>
                        <group>
                             <field name="company_logo" widget="image"
                                   options="{'preview_image': 'company_logo', 'size': [150,150]}" readonly="1"/>
                            <field name="company_address" readonly="1"/>
                            <field name="signatory_name" readonly="1"/>
                            <field name="authorized_signatory" readonly="1"/>
                            <field name="commencement_date" readonly="1"/>
                            <field name="expiry_date" readonly="1"/>

                        </group>

                    </group>
                    <notebook>
                        <page name="contact_info" string="Contact Information">
                            <group>
                                <group string="Primary Contact" name="primary_contact">
                                    <field name="contact_person_title" readonly="1"/>
                                    <field name="contact_email" readonly="1"/>
                                    <field name="contact_phone" readonly="1"/>
                                    <field name="contact_address" readonly="1"/>
                                </group>

                                <group string="Finance Department Contact" name="finance_dept_contact" readonly="1">
                                    <field name="finance_contact_title" readonly="1"/>
                                    <field name="finance_contact_email" readonly="1"/>
                                    <field name="finance_contact_phone" readonly="1"/>
                                    <field name="finance_contact_address" readonly="1"/>
                                </group>

                                <group string="Authorize Contact" name="authorized_contact" readonly="1">
                                    <field name="authorized_person_name" readonly="1"/>
                                    <field name="authorized_person_email" readonly="1"/>
                                    <field name="authorized_person_phone" readonly="1"/>
                                    <field name="authorized_person_address" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page name="bank_info" string="Bank Information">
                            <group>
                                <group name="bank_details" string="Bank Details">
                                    <field name="bank_name" readonly="1"/>
                                    <field name="bank_address" readonly="1"/>
                                    <field name="bank_swift_code" readonly="1"/>
                                    <field name="iban" readonly="1"/>
                                    <field name="company_address_as_per_bank" readonly="1"/>
                                </group>
                                <group name="account_details" string="Account Details">
                                    <field name="account_name" readonly="1"/>
                                    <field name="account_number" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page name="client_info" string="Client Information">
                            <group>
                                <group name="client_1" string="Client 1">
                                    <field name="client_1_name" readonly="1"/>
                                    <field name="client_1_address" readonly="1"/>
                                    <field name="client_1_contact_email" readonly="1"/>
                                    <field name="client_1_contact_phone" readonly="1"/>
                                </group>
                                <group name="client_2" string="client 2">
                                    <field name="client_2_name" readonly="1"/>
                                    <field name="client_2_address" readonly="1"/>
                                    <field name="client_2_contact_email" readonly="1"/>
                                    <field name="client_2_contact_phone" readonly="1"/>
                                </group>
                                <group name="client_3" string="client 3">
                                    <field name="client_3_name" readonly="1"/>
                                    <field name="client_3_address" readonly="1"/>
                                    <field name="client_3_contact_email" readonly="1"/>
                                    <field name="client_3_contact_phone" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page name="certification" string="Certification">
                            <group>
                                <field name="certification" readonly="1"/>
                                <field name="certificate_number" readonly="1"/>
                                <field name="certifying_body" readonly="1"/>
                                <field name="award_date" readonly="1"/>
                                <field name="certificate_expiry_date" readonly="1"/>
                            </group>
                        </page>

                        <page name="document_upload" string="Document Upload">
                            <group>

                                <group>
                                    <field name="trade_license_business_registration" widget="binary" readonly="1"/>
                                    <field name="certificate_of_incorporation" widget="binary"/>
                                    <field name="certificate_of_good_standing" widget="binary"/>
                                    <field name="establishment_card" widget="binary"/>
                                    <field name="vat_tax_certificate" widget="binary"/>
                                </group>
                                <group>
                                    <field name="memorandum_of_association" widget="binary"/>
                                    <field name="identification_document_for_authorized_person" widget="binary"/>
                                    <field name="bank_letter_indicating_bank_account" widget="binary"/>
                                    <field name="past_2_years_audited_financial_statements" widget="binary"/>
                                    <field name="other_certifications" widget="binary"/>
                                    <field name="company_stamp_and_date" widget="binary"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="procurement_management_supplier_registration_view_tree" model="ir.ui.view">
        <field name="name">procurement.management.supplier.registration.view.tree.base</field>
        <field name="model">procurement_management.supplier.registration</field>
        <field name="arch" type="xml">
            <tree string="Supplier Registration">
                <field name="company_name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="trade_license_number"/>
                <field name="commencement_date"/>
                <field name="expiry_date"/>
                <field name="contact_person_title"/>
                <field name="contact_email"/>
                <field name="contact_phone"/>
                <field name="state" widget="badge" decoration-danger="state == 'rejected' or state == 'blacklisted'" decoration-success="state == 'approved'" decoration-warning="state == 'draft' or state == 'submitted' or state == 'recommended'"/>
            </tree>
        </field>
    </record>


    <record id="procurement_management_supplier_registration_view_kanban" model="ir.ui.view">
        <field name="name">procurement.management.supplier.registration.kanban</field>
        <field name="model">procurement_management.supplier.registration</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state" records_draggable="false" quick_create="false">
                <field name="company_name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="state"/>
                <field name="company_type_category"/>
                <field name="trade_license_number"/>
                <field name="commencement_date"/>
                <field name="expiry_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <!-- Kanban Card Design with max-width and overflow handling -->
                        <div class="oe_kanban_global_click o_kanban_record" style="margin: 8px; padding: 0; border: 1px solid #e0e0e0; border-radius: 8px; background: white; max-width: 300px; overflow: hidden;">
                            <!-- Card Header -->
                            <div class="d-flex justify-content-between align-items-center p-3" style="background: linear-gradient(90deg, #4e73df, #224abe); color: white; border-radius: 8px 8px 0 0;">
                                <strong style="font-size: 16px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 70%;">
                                    <span t-esc="record.company_name.raw_value"/>
                                </strong>
                                <span t-attf-class="badge badge-{{ {'draft': 'secondary', 'submitted': 'info', 'recommended': 'warning', 'approved': 'success', 'rejected': 'danger', 'blacklisted': 'dark'}[record.state.raw_value] }} p-2" style="border-radius: 12px;">
                                    <span t-esc="record.state.raw_value"/>
                                </span>
                            </div>

                            <!-- Card Body -->
                            <div class="p-3">
                                <!-- Horizontal Layout for Key Details with text truncation -->
                                <div class="d-flex justify-content-between mb-3">
                                    <div>
                                        <div class="d-flex align-items-center mb-2">
                                            <i class="fa fa-building" style="color: #6c757d; margin-right: 8px;" title="Company Type"/> <!-- Added tooltip -->
                                            <span t-esc="record.company_type_category.raw_value" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 120px;" title="Company Type"/> <!-- Added tooltip and truncation -->
                                        </div>
                                        <div class="d-flex align-items-center mb-2">
                                            <i class="fa fa-envelope" style="color: #6c757d; margin-right: 8px;" title="Email"/> <!-- Added tooltip -->
                                            <span t-esc="record.email.raw_value" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 120px;" title="Email"/> <!-- Added tooltip and truncation -->
                                        </div>
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center mb-2">
                                            <i class="fa fa-phone" style="color: #6c757d; margin-right: 8px;" title="Phone"/> <!-- Added tooltip -->
                                            <span t-esc="record.phone.raw_value" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 120px;" title="Phone"/> <!-- Added tooltip and truncation -->
                                        </div>
                                        <div class="d-flex align-items-center mb-2">
                                            <i class="fa fa-id-card" style="color: #6c757d; margin-right: 8px;" title="Trade License"/> <!-- Added tooltip -->
                                            <span t-esc="record.trade_license_number.raw_value" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 120px;" title="Trade License"/> <!-- Added tooltip and truncation -->
                                        </div>
                                    </div>
                                </div>

                                <!-- Dates Section with text truncation -->
                                <div class="d-flex justify-content-between">
                                    <div class="d-flex align-items-center">
                                        <i class="fa fa-calendar" style="color: #6c757d; margin-right: 8px;" title="Commencement Date"/> <!-- Added tooltip -->
                                        <span t-esc="record.commencement_date.raw_value" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 120px;" title="Commencement Date"/> <!-- Added tooltip and truncation -->
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <i class="fa fa-calendar-times" style="color: #6c757d; margin-right: 8px;" title="Expiry Date"/> <!-- Added tooltip -->
                                        <span t-esc="record.expiry_date.raw_value" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 120px;" title="Expiry Date"/> <!-- Added tooltip and truncation -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="action_procurement_management_supplier_registration" model="ir.actions.act_window">
        <field name="name">Supplier Registration</field>
        <field name="res_model">procurement_management.supplier.registration</field>
        <field name="view_mode">tree,form,search,kanban</field>

    </record>

    <record id="action_procurement_management_supplier_registration_approver" model="ir.actions.act_window">
        <field name="name">Waiting for Approval</field>
        <field name="res_model">procurement_management.supplier.registration</field>
        <field name="view_mode">tree,form,search,kanban</field>
        <field name="domain">[('state','=','reviewed')]</field>
    </record>
    <!-- <field name="domain">['|',('state','=','recommended'),('approver_id','=',uid)]</field> -->

    <record id="action_procurement_management_supplier_registration_reviewer" model="ir.actions.act_window">
        <field name="name">Waiting for Review</field>
        <field name="res_model">procurement_management.supplier.registration</field>
        <field name="view_mode">tree,form,search,kanban</field>
        <field name="domain">[('state','=','submitted')]</field>
    </record>

</odoo>