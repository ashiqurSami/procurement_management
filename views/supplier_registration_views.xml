</record>


    <record id="procurement_management_supplier_registration_view_kanban" model="ir.ui.view">
        <field name="name">procurement_management.supplier.registration.kanban</field>
        <field name="model">procurement_management.supplier.registration</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile"
                    default_group_by="state"
                    records_draggable="false"
                    quick_create="false"
            >
                <field name="company_name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="state"/>
                <field name="company_type_category"/>
                <field name="trade_license_number"/>
                <field name="commencement_date"/>
                <field name="expiry_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <!-- Kanban Card Design -->
                        <div class="oe_kanban_global_click o_kanban_record">
                            <!-- Card Header -->
                            <div class="o_kanban_record_header bg-info text-white p-2">
                                <strong>
                                    <span t-esc="record.company_name.raw_value"/>
                                </strong>
                                <small class="float-right">
                                    <i class="fa fa-building" title="Company Type"/> <span t-esc="record.company_type_category.raw_value"/>
                                </small>
                            </div>

                            <!-- Card Body -->
                            <div class="o_kanban_record_body p-2">
                                <!-- Company Details -->
                                <div class="row mb-2">
                                    <div class="col">
                                        <i class="fa fa-envelope" title="Email"/> <span t-esc="record.email.raw_value"/>
                                    </div>
                                    <div class="col">
                                        <i class="fa fa-phone" title="Phone"/> <span t-esc="record.phone.raw_value"/>
                                    </div>
                                </div>

                                <!-- Trade License and Dates -->
                                <div class="row mb-2">
                                    <div class="col">
                                        <i class="fa fa-id-card" title="Trade License"/> <span t-esc="record.trade_license_number.raw_value"/>
                                    </div>
                                    <div class="col">
                                        <i class="fa fa-calendar" title="Commencement Date"/> <span t-esc="record.commencement_date.raw_value"/>
                                    </div>
                                    <div class="col">
                                        <i class="fa fa-calendar-times" title="Expiry Date"/> <span t-esc="record.expiry_date.raw_value"/>
                                    </div>
                                </div>

                                <!-- State Progress Bar -->
                                <div class="progress mb-2">
                                    <div t-attf-class="progress-bar bg-{{ {'draft': 'secondary', 'submitted': 'info', 'recommended': 'warning', 'approved': 'success', 'rejected': 'danger', 'blacklisted': 'dark'}[record.state.raw_value] }}"
                                         role="progressbar"
                                         t-attf-style="width: {{ {'draft': '20%', 'submitted': '40%', 'recommended': '60%', 'approved': '100%', 'rejected': '100%', 'blacklisted': '100%'}[record.state.raw_value] }}"
                                         aria-valuenow="25"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                        <span t-esc="record.state.raw_value"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_procurement_management_supplier_registration_base" model="ir.actions.act_window">
        <field name="name">Supplier Registration</field>
        <field name="res_model">procurement_management.supplier.registration</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="view_ids"
               eval="[(5, 0, 0),
              (0, 0, {'view_mode': 'tree', 'view_id': ref('procurement_management_supplier_registration_view_tree_base')}),
              (0, 0, {'view_mode': 'form', 'view_id': ref('procurement_management_supplier_registration_view_form_base')}),
              (0, 0, {'view_mode': 'kanban','view_id': ref('procurement_management_supplier_registration_view_kanban')})]"/>
    </record>


</odoo>