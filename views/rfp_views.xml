<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="procurement_management_rfp_view_form" model="ir.ui.view">
        <field name="name">procurement.rfp.form</field>
        <field name="model">procurement_management.rfp</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit"
                            type="object"
                            string="Submit"
                            class="btn btn-primary"
                            invisible="status != 'draft'"
                            groups="procurement_management.group_procurement_management_reviewer"
                    />


                    <button name="action_return_draft" type="object" string="Return to Draft" class="btn btn-secondary" />

                    <button name="action_recommend" type="object" string="Recommend" class="btn btn-info" />
                    <button name="action_approve"
                            type="object"
                            string="Approve"
                            class="btn btn-success"
                            invisible="status !='submitted'"
                            groups="procurement_management.group_procurement_management_approver"
                    />

                    <button name="action_reject"
                            type="object"
                            string="Reject"
                            class="btn btn-danger"
                            invisible="status !='submitted'"
                            groups="procurement_management.group_procurement_management_approver"
                    />

                    <button name="action_close"
                            type="object"
                            string="Close"
                            class="btn btn-dark"
                            invisible="status !='approved'"
                            groups="procurement_management.group_procurement_management_approver"
                    />

                    <button name="action_accept" type="object" string="Accept" class="btn btn-success" />

                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
<!--                    <div class="oe_title">-->
<!--                        <field name="rfp_id_seq" string="RFP ID"/>-->
<!--                    </div>-->
                    <group>

                        <field name="name"/>
                        <field name="required_date"/>
                        <field name="approved_supplier"/>
                    </group>
                    <notebook>
                        <page string="Product Lines">
                            <field name="product_line_ids">
                                <tree editable="True">
                                    <field name="product_ids"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="subtotal"/>
                                </tree>
                            </field>
                        </page>
                        <page string="RFQ Lines">
                            <field name="rfq_line_ids">
                                <tree>
                                    <field name="rfp_id"/>
                                    <field name="expected_delivery_date"/>
                                    <field name="score"/>
                                    <field name="recommended"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="procurement_management_rfp_view_tree" model="ir.ui.view">
        <field name="name">procurement.rfp.tree</field>
        <field name="model">procurement_management.rfp</field>
        <field name="arch" type="xml">
            <tree>
                <field name="rfp_id_seq"/>
                <field name="name"/>
                <field name="status"/>
                <field name="required_date"/>
                <!--                <field name="total_amount"/>-->
            </tree>
        </field>
    </record>

    <record id="action_procurement_management_rfp" model="ir.actions.act_window">
        <field name="name">RFP</field>
        <field name="res_model">procurement_management.rfp</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>