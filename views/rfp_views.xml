<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="procurement_management_rfp_view_form" model="ir.ui.view">
        <field name="name">procurement.rfp.form</field>
        <field name="model">procurement_management.rfp</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit"
                            type="object"
                            string="Submit"
                            class="btn btn-primary"
                            invisible="status != 'draft'"
                            groups="procurement_management.group_procurement_management_reviewer"
                    />

                    <button name="action_return_draft"
                            type="object"
                            string="Return to Draft"
                            class="btn btn-secondary"
                            invisible="status != 'submitted'"
                            groups="procurement_management.group_procurement_management_reviewer"
                    />

                    <button name="action_recommend"
                            type="object"
                            string="Recommend"
                            invisible="status != 'closed'"
                            class="btn btn-info" 
                            groups="procurement_management.group_procurement_management_reviewer"
                            />

                    <button name="action_approve"
                            type="object"
                            string="Approve"
                            class="btn btn-success"
                            invisible="status !='submitted'"
                            groups="procurement_management.group_procurement_management_approver"
                    />

                    <button name="action_reject"
                            type="object"
                            string="Reject"
                            class="btn btn-danger"
                            invisible="status !='submitted'"
                            groups="procurement_management.group_procurement_management_approver"
                    />

                    <button name="action_close"
                            type="object"
                            string="Close"
                            class="btn btn-dark"
                            invisible="status !='approved'"
                            groups="procurement_management.group_procurement_management_approver"
                    />

                    <button name="action_accept"
                            type="object"
                            string="Accept"
                            invisible="status != 'recommended'"
                            class="btn btn-success"
                            groups="procurement_management.group_procurement_management_approver"
                             />

                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <!--                    <div class="oe_title">-->
                    <!--                        <field name="rfp_id_seq" string="RFP ID"/>-->
                    <!--                    </div>-->
                    <group>
                        <field name="name" readonly="status == 'submitted'"/>
                        <field name="required_date" readonly="status == 'submitted'"/>
                        <field name="approved_supplier" readonly="status == 'submitted'"/>
                    </group>

                    <!--                    product_lines-->
                    <notebook>
                        <page string="Product Lines">
                            <field name="product_line_ids"
                                   readonly="status == 'submitted'"
                                   create="status == 'submitted'"
                                   delete="status == 'submitted'">
                                <tree editable="Top">
                                    <field name="product_id" />
                                    <field name="description"/>
                                    <field name="quantity"/>                  
                                </tree>
                            </field>
                        </page>

                        <!--                        RFQ Lines-->
                        <page string="RFQ Lines">
                            <field name="rfq_line_ids"
                                   readonly="status == 'submitted'"
                                   create="status == 'submitted'"
                                   delete="status == 'submitted'">
                                <tree>
                                    <field name="partner_id" />
                                    <field name="expected_delivery_date" />
                                    <field name="score"/>
                                    <field name="warranty_period"/>
                                    <field name="recommended" widget="boolean_toggle" class="text-right"/>
                                </tree>
                                <form>
                                    <group>
                                        <field name="expected_delivery_date" readonly="1"/>
                                        <field name="company_id" invisible="1"/>
                                    </group>
                                    <group>
                                        <field name="partner_id" readonly="1"/>
                                        <field name="score"/>
                                    </group>

                                    <group>
                                        <field name="warranty_period" readonly="1"/>
                                        <field name="recommended" readonly="1"/>
                                    </group>
                                    <notebook>
                                        <page string="RFQ Line Products">
                                            <field name="order_line">
                                                <tree>
                                                    <field name="product_id" />
                                                    <field name="date_approve"/>
                                                    <field name="product_uom_qty"/>
                                                    <field name="price_unit"/>
                                                </tree>
                                            </field>
                                        </page>
                                    </notebook>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="procurement_management_rfp_view_tree" model="ir.ui.view">
        <field name="name">procurement.rfp.tree</field>
        <field name="model">procurement_management.rfp</field>
        <field name="arch" type="xml">
            <tree>
                <field name="rfp_id_seq"/>
                <field name="name"/>
                <field name="status" widget="badge" decoration-danger="status == 'rejected' or status == 'blacklisted' or status == 'closed' "
                       decoration-success="status == 'approved'"
                       decoration-warning="status == 'draft' or status == 'submitted' or status == 'recommended'"/>

                <field name="required_date"/>
                <!--                <field name="total_amount"/>-->
            </tree>
        </field>
    </record>

    <record id="action_procurement_management_rfp" model="ir.actions.act_window">
        <field name="name">RFP</field>
        <field name="res_model">procurement_management.rfp</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>