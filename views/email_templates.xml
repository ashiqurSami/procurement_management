<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="email_template_form_submitted" model="mail.template">
            <field name="name">Form Submitted Notification</field>
            <field name="model_id" ref="base.model_res_users"/> <!-- Use your model's technical name -->
            <field name="subject">Form Submitted for Review</field>
            <field name="email_from">samiashiqur@gmail.com</field> <!-- Hardcoded sender email -->
            <field name="email_to">{{object.email}}</field>
            <field name="body_html" type="html">
                <p>Hello <t t-out="object.name or ''"/> </p>
                <p>A new supplier registration form has been submitted and requires your review.</p>
                <p><strong>Form Details:</strong></p>
                <ul>
                    <li>Supplier Name: <t t-out="ctx.get('name') or N/A"/></li>
                    <li>Supplier Phone: <t t-out="ctx.get('phone') or N/A"/></li>
                    <li>Submission Date: <t t-out="ctx.get('category') or N/A"/></li>
                </ul>
                <p>Please log in to your Odoo account to review the form.</p>
                <p>Thank you,</p>
            </field>
        </record>

        <record id="email_template_vendor_registration_confirmation" model="mail.template">
            <field name="name">Vendor Registration Success</field>
            <field name="model_id" ref="model_res_partner"/>
            <field name="subject">Vendor Registration Successful</field>
            <field name="email_from">samiashiqur@gmail.com</field>
            <field name="email_to">{{object.email}}</field>
            <field name="body_html" type="html">
                <h3>Dear
                    <span><t t-out="object.name or N/A"/> </span>
                </h3>
                <p>Congratulations! Your Vendor Registration has been successfully completed.</p>
                <p>You can now log in to your account using the credentials provided below. Please make sure to change your
                    password to something more secure after logging in.
                </p>
                <p>
                    <strong>Username:</strong>
                    <t t-out="object.email or N/A"/>
                </p>
                <p>
                    <strong>Password:</strong>
                    <t t-out="object.phone or N/A"/>
                </p>
                <p>Thank you for registering with us. We look forward to working with you!</p>

            </field>
        </record>

        <record id="email_template_rfp_approval" model="mail.template">
            <field name="name">RFP Approval Notification</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">New RFP Created</field>
            <field name="email_from">{{ ctx.get('email_to') }}</field>
            <field name="email_to">{{object.email}}</field>
            <field name="body_html" type="html">
                <p>Hello <t t-out="object.name or ''"/>,</p>
                <p>A new <strong>Request for Proposal (RFP)</strong> has been created and requires your approval.</p>
                <p><strong>RFP ID:</strong> <t t-out="ctx.get('rfp_id')"/> </p>
                <p><strong>RFP Name:</strong> <t t-out="ctx.get('name')"/></p>
                <p><strong>Created By:</strong> <t t-out="ctx.get('created_by')"/></p>
                <p>You can review it by clicking the link below:</p>
                <p>Best Regards,<br/>Your Company</p>
            </field>
        </record>

        <record id="email_template_to_notify_reviewer_upon_quotation_submission" model="mail.template">
            <field name="name">New RFQ Notification</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">New RFQ Created</field>
            <field name="email_from">{{ctx.get('email_from')}}</field>
            <field name="email_to">{{object.email}}</field>
            <field name="body_html" type="html">
                <p>Hello,<t t-out="object.name or ''"/></p>
                <p>A new <strong>Request for Quotation (RFQ)</strong> has been created for rfp-<t t-out="ctx.get('rfp_id')"/> and requires your recommendation.</p>
                <p><strong>RFQ Name:</strong> <t t-out="ctx.get('name')"/> </p>
                <p><strong>Vendor Name:</strong> <t t-out="ctx.get('partner_id')"/></p>
                <p><strong>Warranty Period:</strong> <t t-out="ctx.get('warranty_period')"/></p>
                <p>You can review it by clicking the link below:</p>
                <p>Best Regards,<br/>Your Company</p>
            </field>
        </record>

         <record id="email_template_to_notify_approver_upon_recommended_rfq" model="mail.template">
            <field name="name"> RFQ Recommended Notification</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject"> RFQ Recommended</field>
            <field name="email_from">{{ctx.get('email_from')}}</field>
            <field name="email_to">{{object.email}}</field>
            <field name="body_html" type="html">
                <p>Hello,<t t-out="object.name or ''"/></p>
                <p>A new <strong>Request for QuotationS (RFQ)</strong> have been recommended in the RFP( <t t-out="ctx.get('name')"/> )and requires your confirmation.</p>
                <p><strong>RFP Name:</strong> <t t-out="ctx.get('name')"/> </p>
                <p><strong>Created By:</strong> <t t-out="ctx.get('created_by')"/></p>
                <p><strong>Recommended By:</strong> <t t-out="ctx.get('recommended_by')"/></p>
                <p>You can review it by clicking the link below:</p>
                <p>Best Regards,<br/>Your Company</p>
            </field>
        </record>

        <record id="email_template_to_notify_reviewer_upon_rfp_approval" model="mail.template">
            <field name="name"> RFP Approval Notification</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject"> RFP Approval</field>
            <field name="email_from">{{ctx.get('email_from')}}</field>
            <field name="email_to">{{ctx.get('email_to')}}</field>
            <field name="body_html" type="html">
                <p>Hello,<t t-out="object.name or ''"/></p>
                <p>Your requested <strong>Request for Proposal (RFP)</strong> have been approved.</p>
                <p><strong>RFP ID:</strong> <t t-out="ctx.get('rfp_id')"/> </p>
                <p><strong>Created By:</strong> <t t-out="ctx.get('created_by')"/></p>
                <p><strong>Approved By:</strong> <t t-out="ctx.get('approved_by')"/></p>
                <p>You can review it by clicking the link below:</p>
                <p>Best Regards,<br/>Your Company</p>
            </field>
        </record>

        <record id="email_template_to_notify_supplier_upon_rfp_publish_and_approval" model="mail.template">
            <field name="name"> RFP Publish Notification</field>
            <field name="model_id" ref="model_res_partner"/>
            <field name="subject"> RFP Publish</field>
            <field name="email_from">{{ctx.get('email_from')}}</field>
            <field name="email_to">{{object.email}}</field>
            <field name="body_html" type="html">
                <p>Hello,<t t-out="object.name or ''"/></p>
                <p>A new <strong>Request for Proposal (RFP)</strong> have been published in the portal view</p>
                <p><strong>RFP ID:</strong> <t t-out="ctx.get('rfp_id')"/> </p>
                <p><strong>Required Date:</strong> <t t-out="ctx.get('required_date')"/></p>
                <p>You can review it by clicking the link below:</p>
                <a href="http://localhost:8017/procurement_management/rfps"/>
                <p>Best Regards,<br/>Your Company</p>
            </field>
        </record>

         <record id="email_template_to_notify_reviewer_upon_rfp_rejection" model="mail.template">
            <field name="name"> RFP Reject Notification</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject"> RFP Rejection</field>
            <field name="email_from">{{ctx.get('email_from')}}</field>
            <field name="email_to">{{object.email}}</field>
            <field name="body_html" type="html">
                <p>Hello,<t t-out="object.name or ''"/></p>
                <p>This <strong>Request for Proposal (RFP)</strong> have been rejected. The provided information are ambiguous</p>
                <p><strong>RFP ID:</strong> <t t-out="ctx.get('rfp_id')"/> </p>
                <p>You can review it by clicking the link below:</p>
                <a href="http://localhost:8017/procurement_management/rfps">Click Here</a>
                <p>Best Regards,<br/>Your Company</p>
            </field>
        </record>
    </data>
</odoo>
