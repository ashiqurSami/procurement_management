<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="procurement_management.SupplierDashboard">
        <div class="dashboard-container">

            <!-- Filter Section -->
            <div class="filter-section">
                <div class="filter-item">
                    <label>Select Supplier:</label>
                    <select t-model="state.selectedSupplier" t-on-change="onSupplierChange">
                        <t t-foreach="state.suppliers" t-as="supplier" t-key="supplier.id">
                            <option t-att-value="supplier.id" t-esc="supplier.name"/>
                        </t>
                    </select>
                </div>

                <div class="filter-item">
                    <label>Date Range:</label>
                    <select t-model="state.dateRange" t-on-change="onDateRangeChange">
                        <option value="this_week">This Week</option>
                        <option value="last_week">Last Week</option>
                        <option value="last_month">Last Month</option>
                        <option value="last_year">Last Year</option>
                        <option value="custom">Custom Range</option>
                    </select>
                </div>
            </div>

            <!-- Metrics Section -->
            <div class="metrics-section">
                <h3>Supplier Metrics</h3>
                <div class="metrics-grid">
                    <div class="metric-item">
                        <span class="metric-label">Approved RFQs</span>
                        <span class="metric-value"><t t-esc="state.metrics.totalRFQs"/></span>
                    </div>
                    <div class="metric-item">
                        <span class="metric-label">Total Amount</span>
                        <span class="metric-value">
                            <!-- Add currency symbol before the total amount -->
                            <t t-esc="(state.metrics.currency_symbol || '$') + ' ' + state.metrics.totalAmount"/>
                        </span>
                    </div>
                </div>
</div>

            <!-- Product Breakdown Section -->
            <div class="product-breakdown">
                <h3>Product Breakdown</h3>
                <div class="product-grid">
                    <t t-foreach="state.metrics.productBreakdown" t-as="product" t-key="product.name">
                        <div class="product-card">
                            <img t-att-src="'data:image/png;base64,' + product.image" alt="Product Image"/>
                            <div class="product-info">
                                <h4 t-esc="product.name"/>
                                <p>Quantity: <t t-esc="product.quantity"/></p>
                            </div>
                        </div>
                    </t>
                </div>
            </div>

            <!-- Charts Section -->
            <div class="charts-container">
                <div class="chart-box">
                    <h4>Product Quantities</h4>
                    <canvas t-ref="chartBar"></canvas>
                </div>
                <div class="chart-box">
                    <h4>Product Quantity Distribution</h4>
                    <canvas t-ref="chartPie"></canvas>
                </div>
                <div class="chart-box">
                    <h4>RFQ Trend</h4>
                    <canvas t-ref="chartLine"></canvas>
                </div>
                <div class="chart-box">
                    <h4>Total Amount Distribution</h4>
                    <canvas t-ref="chartDoughnut"></canvas>
                </div>
            </div>

        </div>
    </t>
</templates>